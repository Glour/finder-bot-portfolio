# Copy to backend/.env.prod for the API, then configure disposable services.
POSTGRES__DB_HOST=localhost
POSTGRES__DB_PORT=5432
POSTGRES__DB_USER=finder
POSTGRES__DB_PASSWORD=local-only
POSTGRES__DB_NAME=finder
REDIS__REDIS_HOST=localhost
REDIS__REDIS_PORT=6379
REDIS__REDIS_DB=0
IS_DEVELOPMENT=true
ENVIRONMENT=test
# Topic settings are required by the settings model; replace only for your own bot.
BOT__TEST_TOPIC_VERY_HIGH_ID=
BOT__TEST_TOPIC_HIGH_ID=
